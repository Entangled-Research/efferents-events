# /etc/efferents/event.env — read by systemd (root:root, mode 0600).
# Every value here reaches the cluster server, the keeper, the sync job and
# every lab daemon; provider keys never reach experiment commands
# (executor.env_passthrough is an allowlist) and never reach participants.

# Azure OpenAI v1 endpoint and key. Create three Global Standard deployments
# named gpt-4.1-nano, gpt-5.6-luna, and gpt-5.6-sol. Never give this key to
# participants; the hub exchanges their network tokens for upstream calls.
EFFERENTS_AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
OPENAI_API_KEY=replace-with-azure-key

# Where things live.
EFFERENTS_HOME=/srv/efferents/cluster/home
EFFERENTS_CLUSTER_DIR=/srv/efferents/cluster
POPPER_PROBE_REPO=/srv/efferents/popper-probe

# The host calls Azure directly; laptop labs use the hub's /proxy/openai/v1.
EFFERENTS_API_BASE=https://YOUR-RESOURCE.openai.azure.com/openai/v1
EFFERENTS_MODEL=openai/gpt-5.6-luna
EFFERENTS_MODEL_SUPERVISOR=openai/gpt-5.6-sol
EFFERENTS_MODEL_ANALYST=openai/gpt-5.6-sol
EFFERENTS_MODEL_CODER=openai/gpt-5.6-sol
EFFERENTS_MODEL_LIBRARIAN=openai/gpt-5.6-luna
EFFERENTS_MODEL_REVIEWER=openai/gpt-5.6-luna
EFFERENTS_MODEL_REBUTTAL=openai/gpt-4.1-nano

# Fleet-wide rate control: at most this many provider calls in flight across
# all daemons (flock slots under $EFFERENTS_HOME/locks). Lower it if the
# provider console shows 429s. 0 disables.
EFFERENTS_MAX_CONCURRENT_CALLS=12
EFFERENTS_ANTHROPIC_MAX_RETRIES=4

# Bounded-event overrides (EFFERENTS_CADENCE_<KEY> beats lab.yaml).
EFFERENTS_CADENCE_BACKOFF_CAP_S=300
EFFERENTS_STALL_HOURS=0.25

# Operator notifications (ntfy.sh topic; treat as a secret). The keeper
# strips this from daemon environments so 50 labs cannot spam your phone.
NTFY_TOPIC=

# Keep numpy/BLAS to one thread per experiment process.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
