[Unit]
Description=efferents event cluster — keeper (daemon supervision, spend caps, status.json)
After=network-online.target efferents-cluster.service

[Service]
User=efferents
Group=efferents
WorkingDirectory=/srv/efferents/current
EnvironmentFile=/etc/efferents/event.env
ExecStart=/srv/efferents/current/.venv/bin/efferents cluster keeper /srv/efferents/cluster
Restart=always
RestartSec=5
KillMode=process
LimitNOFILE=65536
TasksMax=infinity

[Install]
WantedBy=multi-user.target
